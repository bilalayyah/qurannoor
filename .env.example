# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# QURAN FOUNDATION API CREDENTIALS (Server-Side Only)
# Register at https://api-docs.quran.com/ to obtain OAuth2 client credentials.
# When omitted, the server gracefully uses the official public Quran Foundation API v4 endpoint.
QURAN_CLIENT_ID=""
QURAN_CLIENT_SECRET=""
QURAN_ENV="production"

# OPTIONAL CONTACT FORM ENDPOINT (Client-Safe URL Only, e.g. Cloudflare Worker Form Handler)
VITE_CONTACT_ENDPOINT=""

